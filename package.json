{
  "name": "@hallucine/tente",
  "version": "0.36.3",
  "description": "Le vocabulaire partagé de la gamme gonflable : composition et règles de la tente, code de configuration, teintes, habillage du mobilier, pose des visuels et visualiseur 3D. Installé par le site public et par le CRM.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/three": "^0.180.0",
    "react": "^19.2.8",
    "three": "^0.180.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.160"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.3.2",
      "esbuild": "^0.25.0"
    }
  }
}
